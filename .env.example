# ==============================================================================
# ShopCraft Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
# CRITICAL: The frozen BrewMellow midterm baseline (ep-dark-term-avy8vnke) must NEVER
# be used for ShopCraft SaaS. In local development, leaving SHOPCRAFT_DATABASE_URL
# empty defaults to an isolated local SQLite database (shopcraft_dev.sqlite3).
# On Heroku/staging/production, supply the branch-specific Neon connection URL.
SHOPCRAFT_DATABASE_URL=
SHOPCRAFT_ALLOW_DATABASE_URL=0
LEGACY_NEON_HOST=ep-dark-term-avy8vnke

# Django Core Security
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-secret-key-change-in-production
FIELD_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Origins, CORS & CSRF
DJANGO_API_ORIGIN=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Transactional Email (Resend via Anymail)
# In local dev (DEBUG=True), console backend is used and dev_otp_hint is returned.
# In staging/production, configure RESEND_API_KEY for 6-digit OTP delivery.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=ShopCraft <noreply@shopcraft.com.np>

# Google OAuth 2.0 Web Client
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
