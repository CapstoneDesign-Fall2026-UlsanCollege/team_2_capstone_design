# ==============================================================================
# ShopCraft Environment Configuration (.env.example)
# Copy to backend/.env (and frontend/.env.local for NEXT_PUBLIC_* / DJANGO_API_ORIGIN)
# NEVER commit real secrets, API keys, OTPs, tokens, emails, or connection URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon PostgreSQL with FORCE RLS)
# ------------------------------------------------------------------------------
# Local dev: leave DATABASE_URL / SHOPCRAFT_DATABASE_URL blank to use SQLite.
# Production runtime: set DATABASE_URL to the Neon POOLED (-pooler) URL using a
# NOSUPERUSER NOBYPASSRLS role. Set DATABASE_URL_DIRECT to the unpooled Neon URL
# for release-phase migrations only.
DATABASE_URL=
DATABASE_URL_DIRECT=
SHOPCRAFT_DATABASE_URL=
DB_CONN_MAX_AGE=60
LEGACY_NEON_HOST=ep-dark-term-avy8vnke

# ------------------------------------------------------------------------------
# 2. Django Core Security, Hosts & Cookies
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production-use-at-least-32-random-chars
FIELD_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=86400

# ------------------------------------------------------------------------------
# 3. Origins, CORS & CSRF (Frontend <-> Backend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DJANGO_API_ORIGIN=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. Transactional Email OTP (Resend API default | built-in SMTP)
# ------------------------------------------------------------------------------
EMAIL_TRANSPORT=resend_api
DEFAULT_FROM_EMAIL=auth@send.example.com
RESEND_API_KEY=
RESEND_TIMEOUT=4.5
EMAIL_SEND_ASYNC=True

# Optional SMTP settings (used only when EMAIL_TRANSPORT=smtp)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# ------------------------------------------------------------------------------
# 5. Google Identity Services (Storefront Customers & Merchants)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. Payments (Khalti stays in SANDBOX by default) & Media (Cloudinary)
# ------------------------------------------------------------------------------
KHALTI_LIVE_ENABLED=False
KHALTI_PLATFORM_SANDBOX_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. Proxy & Salted Client-IP Verification
# ------------------------------------------------------------------------------
TRUSTED_PROXY_HEADER=
LOG_HASHED_CLIENT_IP=False
