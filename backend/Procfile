web: gunicorn core.wsgi --preload --worker-class gthread --workers ${WEB_CONCURRENCY:-4} --threads ${WEB_THREADS:-8} --timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --access-logfile -
release: DATABASE_URL=$DATABASE_URL_DIRECT sh -c "python manage.py migrate --noinput && python manage.py createcachetable"
